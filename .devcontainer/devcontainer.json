{
  "name": "kiamol",
  "build": {
    "dockerfile": "./Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": { "moby": false }
  },
  // Host network so kubectl reaches the kind API server, which listens on the Docker host's 127.0.0.1.
  "runArgs": ["--network=host"],
  "customizations": {
    "vscode": {
      "extensions": [
        "jetpack-io.devbox"
      ]
    }
  },
  "remoteUser": "devbox"
}
